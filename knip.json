{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/build.js"],
      "project": ["*.js", "scripts/*.js"]
    },
    "packages/build": {
      "entry": ["src/build.js", "src/computeNodeModulesCacheKey.js"],
      "project": ["src/**/*.js"]
    },
    "packages/extension-host-helper-process": {
      "entry": ["index.js", "src/extensionHostHelperProcessMain.ts", "test/**/*.test.ts"],
      "project": ["index.js", "src/**/*.{js,ts}", "test/**/*.ts"]
    },
    "packages/memory": {
      "entry": ["src/measureMemory.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
